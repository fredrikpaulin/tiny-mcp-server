{
  "name": "tiny-mcp-server",
  "version": "0.5.0",
  "description": "Modular toolkit for building MCP servers on Bun — persistent context graph, incremental code scanning, full-text search, and built-in input validation",
  "author": {
    "name": "Fredrik Paulin",
    "email": "fredrik@rymdskepp.com"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "server",
    "bun",
    "model-context-protocol",
    "anthropic",
    "claude"
  ],
  "type": "module",
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "test": "bun test test/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun test test/ && tsc --noEmit"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mcp": "./src/mcp.ts",
    "./modules/*": "./src/modules/*.ts",
    "./analyzer/parser": "./src/analyzer/parser.js",
    "./analyzer/ast": "./src/analyzer/ast.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredrikpaulin/tiny-mcp-server.git"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
